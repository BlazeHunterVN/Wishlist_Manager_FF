{
  "rewrites": [
    {
      "source": "/api/wishlist",
      "destination": "https://macxtools.vercel.app/api/wishlist"
    },
    {
      "source": "/api/wish/:region/:path*",
      "destination": "https://macxwishlist.vercel.app/api/wish/:region/:path*"
    },
    {
      "source": "/api/wishlist/:region/:path*",
      "destination": "https://macxwish.vercel.app/api/wishlist/:region/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}